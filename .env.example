# =============================================================================
# Insurance For All — environment template (COMMIT THIS FILE ONLY)
# =============================================================================
# Copy to .env locally:  Copy-Item .env.example .env
# SSOT: ENVIRONMENT.md · service boundaries: TECH_STACK.md §6
#
# NEVER commit .env or paste real keys into docs, Notion, issues, PRs, or chat.
# NEVER use NEXT_PUBLIC_* for API keys (Next.js bundles them to the browser).
#
# Generate app secrets (32+ bytes, base64):
#   openssl rand -base64 32

# -----------------------------------------------------------------------------
# Application (non-secret)
# -----------------------------------------------------------------------------
APP_ENV=
LOG_LEVEL=

# Retention defaults (MVP — align with privacy notice before production)
DOCUMENT_RESULT_RETENTION_HOURS=
AI_REPORT_RETENTION_DAYS=
CONSULTATION_RETENTION_DAYS=

# Compliance metadata (non-secret; rotate with consent copy / key rotation)
ENCRYPTION_KEY_VERSION=
CONSULTATION_CONSENT_NOTICE_VERSION=

# -----------------------------------------------------------------------------
# apps/web — NO external API keys, NO peppers, NO NEXT_PUBLIC_* secrets
# -----------------------------------------------------------------------------
# Internal API base URL (Next.js rewrite /api → FastAPI). Host npm: localhost.
# docker compose web 서비스는 Compose가 http://api:8000 으로 덮어 쓴다.
API_INTERNAL_URL=

# -----------------------------------------------------------------------------
# apps/api — OpenAI, session/report peppers, consultation crypto, SMTP
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=

CONTACT_ENCRYPTION_KEY=
SESSION_TOKEN_PEPPER=
REPORT_TOKEN_PEPPER=

# Consultation: P0 email-only UI; notify designer/operator inbox
CONSULTATION_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Cookie Secure 플래그. 로컬 HTTP와 docker-compose.prod.yml 스모크는 false.
# HTTPS가 적용되는 B-5 데모에서는 true.
SESSION_COOKIE_SECURE=

# -----------------------------------------------------------------------------
# apps/worker — Public Data Portal keys + batch (F-11); Celery
# -----------------------------------------------------------------------------
# Use Decoding keys with httpx params= (see ENVIRONMENT.md §2)
DATA_GO_KR_MEDICAL_API_KEY=
DATA_GO_KR_AUTO_API_KEY=
DATA_GO_KR_LIFE_API_KEY=

CELERY_CONCURRENCY=

# -----------------------------------------------------------------------------
# Tier-3 data store variable names
# -----------------------------------------------------------------------------
# Host-side URLs for local tools. Compose overrides DATABASE_URL / REDIS_URL
# to the postgres and redis service hostnames.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_URL=

# -----------------------------------------------------------------------------
# EC2 demo (t4g.small / Ubuntu 24.04): copy these names to a repository-external
# file, chmod 600, docker compose --env-file. Do not put this file in the repo.
# GitHub Actions Secrets are CI-only. Do not add Secrets Manager lookup in the app.
# -----------------------------------------------------------------------------
